{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suttaflow:target-units:2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "subject_id",
    "revision_id",
    "encoding",
    "content",
    "units"
  ],
  "properties": {
    "schema": {
      "const": "suttaflow-target-units-v2"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "encoding": {
      "const": "UTF-8"
    },
    "content": {
      "$ref": "#/$defs/artifact"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "byte_range"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "byte_range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$comment": "The runtime verifies unique IDs, exact CORE identity, UTF-8 range boundaries, no overlaps and no omitted non-whitespace bytes. Source and target unit counts may differ."
}
