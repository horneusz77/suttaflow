{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suttaflow:source-provenance:1",
  "title": "Scoped provenance ledger and attributed assessment; no change to DEC-03 group counts",
  "oneOf": [
    {"$ref": "#/$defs/ledger"},
    {"$ref": "#/$defs/assessment"}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/sha256"}},
      "description": "Runtime resolves paths within the evidence root, reads actual bytes and verifies the hash."
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "path", "sha256", "json_pointer"],
      "properties": {
        "source_id": {"$ref": "#/$defs/text"}, "path": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/sha256"}, "json_pointer": {"enum": ["", "/translation_text"]}
      }
    },
    "source_pair": {
      "type": "object", "additionalProperties": false, "required": ["HH", "SUJATO"],
      "properties": {"HH": {"$ref": "#/$defs/source"}, "SUJATO": {"$ref": "#/$defs/source"}},
      "description": "Runtime requires the exact source identity, file revision and selector of the current lexical input."
    },
    "support": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "byte_start", "byte_end", "excerpt_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/sha256"},
        "byte_start": {"type": "integer", "minimum": 0},
        "byte_end": {"type": "integer", "minimum": 1}, "excerpt_sha256": {"$ref": "#/$defs/sha256"}
      },
      "description": "Runtime requires 0 <= byte_start < byte_end <= file length and checks the nonempty exact excerpt hash."
    },
    "ledger": {
      "type": "object", "additionalProperties": false, "required": ["schema", "assessments"],
      "properties": {
        "schema": {"const": "suttaflow-source-provenance-ledger-v1"},
        "assessments": {"type": "array", "items": {"$ref": "#/$defs/artifact"}, "uniqueItems": true}
      }
    },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "assessment_id", "relationship", "segment_scope", "sources", "basis_kind", "assessor", "assessed_at", "rationale", "support"],
      "properties": {
        "schema": {"const": "suttaflow-source-provenance-assessment-v1"},
        "assessment_id": {"$ref": "#/$defs/text"},
        "relationship": {"enum": ["DEPENDENT", "INDEPENDENT"]},
        "segment_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "sources": {"$ref": "#/$defs/source_pair"},
        "basis_kind": {"enum": ["EXPLICIT_PROVENANCE_STATEMENT", "DOCUMENTED_PROVENANCE_RESEARCH"]},
        "assessor": {
          "type": "object", "additionalProperties": false, "required": ["id", "kind"],
          "properties": {"id": {"$ref": "#/$defs/text"}, "kind": {"enum": ["SOURCE_PUBLISHER", "HUMAN", "AI"]}}
        },
        "assessed_at": {
          "type": "string", "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "rationale": {"$ref": "#/$defs/text"}, "support": {"$ref": "#/$defs/support"}
      },
      "description": "An attributed, scoped record, not authentication of its author or a philological/publication approval. Lexical difference alone cannot supply this record."
    }
  }
}
