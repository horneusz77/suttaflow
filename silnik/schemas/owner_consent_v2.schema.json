{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suttaflow:owner-consent:2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "status",
    "owner_id",
    "subject_id",
    "revision_id",
    "content_sha256",
    "scope",
    "issued_at",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "PUBLICATION_CONSENT",
        "HUMAN_REVIEW_WAIVER"
      ]
    },
    "status": {
      "const": "APPROVED"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "$ref": "#/$defs/artifact"
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
