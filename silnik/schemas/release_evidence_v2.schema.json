{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suttaflow:release-evidence:2",
  "title": "SuttaFlow release evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "subject"
  ],
  "properties": {
    "schema": {
      "const": "suttaflow-release-evidence-v2"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "revision_id",
        "content",
        "scope"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "revision_id": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "$ref": "#/$defs/artifact"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        }
      }
    },
    "r0": {
      "$ref": "#/$defs/artifact"
    },
    "read_order": {
      "$ref": "#/$defs/artifact"
    },
    "author_report": {
      "$ref": "#/$defs/artifact"
    },
    "reviewer_report": {
      "$ref": "#/$defs/artifact"
    },
    "human_review": {
      "$ref": "#/$defs/artifact"
    },
    "hh_licence": {
      "$ref": "#/$defs/artifact"
    },
    "final_editor_acceptance": {
      "$ref": "#/$defs/artifact"
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "scope",
        "frozen_at",
        "freeze_record"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "frozen_at": {
          "type": "string",
          "format": "date-time"
        },
        "freeze_record": {
          "$ref": "#/$defs/artifact"
        },
        "review_mode": {
          "enum": [
            "WHOLE",
            "PARTS"
          ]
        },
        "split": {
          "type": "boolean"
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "coverage",
        "apparatus",
        "ik",
        "id",
        "ir",
        "format_native",
        "format_pdf",
        "translation_log"
      ],
      "properties": {
        "sources": {
          "$ref": "#/$defs/artifact"
        },
        "coverage": {
          "$ref": "#/$defs/artifact"
        },
        "apparatus": {
          "$ref": "#/$defs/artifact"
        },
        "ik": {
          "$ref": "#/$defs/artifact"
        },
        "id": {
          "$ref": "#/$defs/artifact"
        },
        "ir": {
          "$ref": "#/$defs/artifact"
        },
        "format_native": {
          "$ref": "#/$defs/artifact"
        },
        "format_pdf": {
          "$ref": "#/$defs/artifact"
        },
        "translation_log": {
          "$ref": "#/$defs/artifact"
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$comment": "Runtime checks also bind exact bytes, identities, timestamps, scope, closed issues, prior exposure and report sequencing. This schema never creates authority."
}
