{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suttaflow:source-read-attestation:2",
  "type": "object",
  "required": [
    "kind",
    "subject_id",
    "revision_id",
    "content_sha256",
    "scope",
    "source_id",
    "source_metadata",
    "actor_id",
    "context_id",
    "locator",
    "at",
    "read_mode",
    "authenticated_source",
    "applicable_profiles",
    "usage_loci",
    "evidence_text"
  ],
  "properties": {
    "kind": {
      "const": "SOURCE_READ_ATTESTATION"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_metadata": {
      "type": "object",
      "required": [
        "profile_role",
        "evidence_kind",
        "language",
        "title",
        "author_or_editor",
        "edition",
        "actual_carrier"
      ],
      "properties": {
        "profile_role": {
          "type": "string",
          "minLength": 1
        },
        "evidence_kind": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "author_or_editor": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "actual_carrier": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "context_id": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "read_mode": {
      "enum": [
        "CAPTURE_READING",
        "BOOK_READING",
        "DIRECT_SOURCE_READING"
      ]
    },
    "authenticated_source": {
      "type": "object",
      "required": [
        "actor_id",
        "uri",
        "record_id"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "applicable_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "usage_loci": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_text": {
      "type": "string",
      "minLength": 1
    },
    "capture_ref": {
      "$ref": "#/$defs/artifact"
    },
    "read_byte_ranges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "read_mode": {
            "const": "CAPTURE_READING"
          }
        }
      },
      "then": {
        "required": [
          "capture_ref",
          "read_byte_ranges"
        ]
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$comment": "Byte identity, actual scope and ordering are checked by source_contract. BOOK_READING and DIRECT_SOURCE_READING do not require a full capture. Profile-specific evidence such as dictionary entries, Vinaya structure and HH source notes remains available."
}
